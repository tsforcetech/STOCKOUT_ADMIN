# Apache: single-page app fallback. Any URL that isn't a real file or folder (e.g. /seller/listings,
# /legal/terms) is served index.html, so refreshing or opening a deep link works. Needs mod_rewrite.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# index.html must never be cached, or users keep loading old asset names after a deploy.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
