# Base URL of the STOCKOUT API gateway used by the built app.
# Leave empty to call same-origin /api (recommended: serve the admin behind the same host
# or a reverse proxy). Set to https://stockout.flowb.io to call the gateway directly (CORS).
VITE_API_BASE_URL=

# Development only: where `npm run dev` proxies /api/* requests.
VITE_DEV_PROXY_TARGET=https://stockout.flowb.io

# Where the refresh token is kept between page loads: "session" (tab-scoped, default) or "local".
VITE_REFRESH_TOKEN_STORAGE=local

# Public path the app is served from. "/" by default; "/stockout_admin/" for GitHub Pages project sites.
VITE_BASE_PATH=/

# Public marketplace (buyer site) used for "create an account" links on the invitation page.
VITE_MARKETPLACE_URL=https://tsforcetech.github.io/STOCKOUT_BUYER

# Browser push (Firebase Cloud Messaging). PUBLIC web-app config + PUBLIC Web Push (VAPID) key only — these are
# identifiers, not secrets. Never put the service-account JSON / private_key here. Push is offered only when all six are
# set; the service worker (firebase-messaging-sw.js) is generated from the same values at build time.
# Firebase project: stockout-ed96a (must be the same project as NotificationIntegration.Worker).
VITE_FIREBASE_API_KEY=AIzaSyCie4y05ciKDiPK86PB5_M8TXtRArPLAv4
VITE_FIREBASE_AUTH_DOMAIN=stockout-ed96a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stockout-ed96a
VITE_FIREBASE_MESSAGING_SENDER_ID=1030551751652
VITE_FIREBASE_APP_ID=1:1030551751652:web:8f519aecedf78cec3395f1
VITE_FIREBASE_VAPID_KEY=BBSJ0Wta_A8eU4Dh76r09HbdulQEKpSYCnD29eAlFtrZ61-33K8RvfhZ07s-WOA6363RjpnkkF9L-JfewAHfFpU
