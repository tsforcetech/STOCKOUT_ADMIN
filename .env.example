# Base URL of the STOCKOUT API gateway used by the built app.
# Leave empty to call same-origin /api (recommended: serve the admin behind the same host
# or a reverse proxy). Set to https://stockout.flowb.io to call the gateway directly (CORS).
VITE_API_BASE_URL=

# Development only: where `npm run dev` proxies /api/* requests.
VITE_DEV_PROXY_TARGET=https://stockout.flowb.io

# Where the refresh token is kept between page loads: "session" (tab-scoped, default) or "local".
VITE_REFRESH_TOKEN_STORAGE=local

# Public path the app is served from. "/" by default; "/stockout_admin/" for GitHub Pages project sites.
VITE_BASE_PATH=/

# Public marketplace (buyer site) used for "create an account" links on the invitation page.
VITE_MARKETPLACE_URL=https://tsforcetech.github.io/STOCKOUT_BUYER
